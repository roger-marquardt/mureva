generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationStatus {
  OPEN
  COMPLETED
  ABANDONED
}

enum MessageRole {
  USER
  ASSISTANT
}

model ModelPrice {
  id                       String   @id @default(cuid())
  provider                 String   @default("openai")
  model                    String   @unique
  inputPerMillionUsd       Decimal  @db.Decimal(12, 6)
  cachedInputPerMillionUsd Decimal  @db.Decimal(12, 6)
  cacheWritePerMillionUsd  Decimal  @db.Decimal(12, 6)
  outputPerMillionUsd      Decimal  @db.Decimal(12, 6)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Conversation {
  id                String             @id @default(cuid())
  status            ConversationStatus @default(OPEN)
  lead              Json               @default("{}")
  model             String
  ip                String?
  ipCity            String?
  ipRegion          String?
  ipCountry         String?
  ipNetwork         String?
  userAgent         String?
  inputTokens       Int                @default(0)
  cachedInputTokens Int                @default(0)
  outputTokens      Int                @default(0)
  costUsd           Decimal?           @db.Decimal(14, 8)
  emailSentAt       DateTime?
  emailError        String?
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  messages          Message[]
  llmCalls          LlmCall[]

  @@index([status, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model LlmCall {
  id                String       @id @default(cuid())
  conversationId    String
  step              Int
  purpose           String
  model             String
  request           Json
  response          Json
  inputTokens       Int?
  cachedInputTokens Int?
  cacheWriteTokens  Int?
  outputTokens      Int?
  costUsd           Decimal?     @db.Decimal(14, 8)
  latencyMs         Int?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
